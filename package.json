{
  "name": "smaen",
  "description": "スマートエンカウント — ふたりの中間の駅で待ち合わせ",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "start": "bun ./build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "oxlint && bun fmt --check",
    "format": "oxlint --fix && bun fmt"
  },
  "devDependencies": {
    "@picocss/pico": "^2.1.1",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@7",
    "oxlint": "^1.90.0",
    "sass-embedded": "^1.107.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
