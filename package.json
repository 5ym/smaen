		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@picocss/pico": "^2.1.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bun": "^1.2.19",
		"sass-embedded": "^1.104.1",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.0",
		"typescript": "^7.0.0",
		"vite": "^8.0.0"
	}
}
